#!name = BiliBili CDN Redirect for Loon
#!desc = 将 Bilibili 普通视频播放地址重定向到所选 CDN。优先在 playurl 响应中改写 DASH/durl，并以 CDN 请求作为兼容 fallback；手动列表按地区维护节点候选，支持自动选择节点与可配置的当前 CDN 持续带宽测试。
#!author = vulpsecula
#!homepage = https://github.com/vulpsecula/BiliBili-CDN-Loon
#!icon = https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/assets/icon.png
#!tag = Bilibili,CDN,Loon,视频
#!type = normal
#!version = 1.11.0
#!date = 2026-11-20
#!system = iOS,iPadOS,tvOS,macOS
#!system_version = 15
#!loon_version = 3.5.1(983)

[Argument]
cdn = select,"cn-hk-eq-01-01.bilivideo.com","──── 香港 ────","cn-hk-eq-01-03.bilivideo.com","cn-hk-eq-01-06.bilivideo.com","cn-hk-eq-01-08.bilivideo.com","cn-hk-eq-01-09.bilivideo.com","cn-hk-eq-01-10.bilivideo.com","cn-hk-eq-01-11.bilivideo.com","cn-hk-eq-01-12.bilivideo.com","cn-hk-eq-01-13.bilivideo.com","cn-hk-eq-01-14.bilivideo.com","──── 山东 ────","cn-sdjn-cm-02-01.bilivideo.com","cn-sdjn-cm-02-02.bilivideo.com","cn-sdjn-cm-02-03.bilivideo.com","cn-sdjn-cm-02-04.bilivideo.com","cn-sdjn-cm-02-05.bilivideo.com","cn-sdjn-cm-02-06.bilivideo.com","cn-sdjn-cm-02-07.bilivideo.com","cn-sdjn-cm-02-08.bilivideo.com","cn-sdjn-cm-02-09.bilivideo.com","cn-sdjn-cm-02-10.bilivideo.com","cn-sdjn-cm-02-11.bilivideo.com","cn-sdjn-cm-02-13.bilivideo.com","cn-sdjn-fx-01-01.bilivideo.com","cn-sdjn-fx-01-02.bilivideo.com","cn-sdqd-ccc-01-01.bilivideo.com","cn-sdqd-cu-01-08.bilivideo.com","cn-sdqd-cu-01-11.bilivideo.com","cn-sdqd-cu-01-21.bilivideo.com","cn-sdqd-cu-01-23.bilivideo.com","cn-sdqd-cu-01-24.bilivideo.com","cn-sdqd-cu-01-25.bilivideo.com","──── 江西 ────","cn-jxnc-cm-01-04.bilivideo.com","cn-jxnc-cm-01-09.bilivideo.com","cn-jxnc-cm-01-12.bilivideo.com","cn-jxnc-cm-01-19.bilivideo.com","cn-jxnc-cm-01-42.bilivideo.com","cn-jxnc-cmcc-bcache-06.bilivideo.com","──── 深圳 ────","upos-sz-302ppio.bilivideo.com","upos-sz-estgcos.bilivideo.com","upos-sz-estghw.bilivideo.com","upos-sz-estgoss.bilivideo.com","upos-sz-mirror08c.bilivideo.com","upos-sz-mirror08ct.bilivideo.com","upos-sz-mirror08disp.bilivideo.com","upos-sz-mirrorali.bilivideo.com","upos-sz-mirroralib.bilivideo.com","upos-sz-mirrorbd.bilivideo.com","upos-sz-mirrorbdb.bilivideo.com","upos-sz-mirrorcos.bilivideo.com","upos-sz-mirrorcosb.bilivideo.com","upos-sz-mirrorcosdisp.bilivideo.com","upos-sz-mirrorcoso1.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorhwb.bilivideo.com","upos-sz-mirrorhwdisp.bilivideo.com","upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirrorzos.bilivideo.com","──── 海外 ────","upos-sz-mirror08h.bilivideo.com","upos-sz-mirroraliov.bilivideo.com","upos-sz-mirrorcosov.bilivideo.com","──── 外建 ────","c0--cn-gotcha01.bilivideo.com",tag=目标 CDN 节点,desc=手动模式直接使用；自动选择节点开启时作为失败/并发测速时的回退节点。地区分隔项仅用于标识，不可作为 CDN；新增节点不保证已完成实测。
auto = switch,false,tag=⚡ 自动选择节点,desc=关闭时始终使用手动 CDN；开启时由实际 CDN 请求触发同 family 测速并自动选择节点，失败则回退手动 CDN；结果按网络与 family 缓存 6 小时。
debug = switch,false,tag=调试日志,desc=开启 Loon Script 调试，排查重定向与测速问题；日常使用建议关闭。
dns_preflight = switch,false,tag=DNS 预检（可选）,desc=仅自动测速时查询候选节点 DNS；只有 NO_ANSWER 会跳过，其他异常仍执行 HTTP 测速。需要 Loon Build 988+，旧版自动跳过。
refresh_on_network = switch,true,tag=网络变化后刷新测速缓存,desc=网络切换时仅失效当前网络的自动测速缓存；下次播放时再测速，不额外消耗流量。
test_bvid = input,"BV1eL4k6jEjd",tag=🎞 测试视频 BV号,desc=仅用于“测试当前 CDN 持续带宽”；优先复用最近真实播放的 signed URL 与请求头；没有近期样本时才尝试该视频网页内嵌 playinfo。
test_seconds = input,6,type=number,tag=⏱ 单轮测速秒数,desc=手动持续带宽测试每轮目标时长；默认 6 秒，脚本实际限制在 3–10 秒，共测试 3 轮。

[Script]
response if ${url} ~= /^https?:\/\/api\.(?:bilibili\.com|biliapi\.net)\/(?:x\/player\/(?:(?:wbi\/)?playurl|wbi\/v2)|pgc\/player\/(?:api|web)(?:\/v\d+)?\/playurl(?:\/html5)?|pugv\/player\/web\/playurl)(?:\?|$)/i && ${response.status} == 200 then script("https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/custom/BiliBili.CDN.Redirect.Loon.response.js", {${cdn}, ${auto}}) with tag="📺 BiliBili.CDN.Redirect.Loon.playurl", timeout=30, debug=${debug}, requires_body=true
request if ${url} ~= /^https?:\/\/(?:(?:[A-Za-z0-9-]+\.)*(?:bilivideo|acgvideo)\.com|(?:[A-Za-z0-9-]+\.)*bilivideo\.cn)(?::[0-9]+)?\/upgcxcode\//i && ${request.header['X-BiliBili-CDN-Redirect-Speedtest']} == null then script("https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/custom/BiliBili.CDN.Redirect.Loon.request.js", {${cdn}, ${auto}, ${dns_preflight}}) with tag="📺 BiliBili.CDN.Redirect.Loon.upgcxcode", timeout=30, debug=${debug}
request if ${url} ~= /^https?:\/\/upos-(?:hz|sz|bstar1)-mirrorakam\.akamaized\.net(?::[0-9]+)?\/upgcxcode\//i && ${request.header['X-BiliBili-CDN-Redirect-Speedtest']} == null then script("https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/custom/BiliBili.CDN.Redirect.Loon.request.js", {${cdn}, ${auto}, ${dns_preflight}}) with tag="📺 BiliBili.CDN.Redirect.Loon.akamaized", timeout=30, debug=${debug}
network-changed then script("https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/custom/BiliBili.CDN.Redirect.Loon.network.js") with enable=${refresh_on_network}, tag="📶 网络变化后刷新 CDN 缓存", timeout=10, debug=${debug}
generic then script("https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/custom/BiliBili.CDN.Redirect.Loon.bandwidth.js", {${cdn}, ${auto}, ${test_bvid}, ${test_seconds}}) with tag="🎯 测试当前 CDN 持续带宽", img_url="speedometer.system", timeout=60, debug=${debug}
generic then script("https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/custom/BiliBili.CDN.Redirect.Loon.result.js", {${cdn}, ${auto}}) with tag="📊 查看自动选择节点结果", img_url="list.bullet.rectangle.system", timeout=10, debug=${debug}

[MITM]
hostname = api.bilibili.com, api.biliapi.net, *.bilivideo.com, *.bilivideo.cn, *.acgvideo.com, upos-hz-mirrorakam.akamaized.net, upos-sz-mirrorakam.akamaized.net, upos-bstar1-mirrorakam.akamaized.net