auto = switch,false,tag=⚡ 自动测速,desc=关闭时始终使用手动 CDN；开启时由实际 CDN 请求触发同 family 自动测速，失败则回退手动 CDN；结果按网络与 family 缓存 6 小时。

[Script]
http-response ^https?:\/\/api\.(?:bilibili\.com|biliapi\.net)\/(?:x\/player\/(?:(?:wbi\/)?playurl|wbi\/v2)|pgc\/player\/(?:api|web)(?:\/v\d+)?\/playurl(?:\/html5)?|pugv\/player\/web\/playurl)(?:\?|$) script-path=https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/custom/BiliBili.Redirect.CCBStyle.response.js, requires-body=true, tag=📺 BiliBili.Redirect.CCBStyle.playurl, timeout=30, argument=[{cdn},{auto}]
http-request ^https?:\/\/(?:(?:[A-Za-z0-9-]+\.)*(?:bilivideo|acgvideo)\.com|(?:[A-Za-z0-9-]+\.)*bilivideo\.cn)(?::[0-9]+)?\/upgcxcode\/ script-path=https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/custom/BiliBili.Redirect.CCBStyle.request.js, tag=📺 BiliBili.Redirect.CCBStyle.upgcxcode, timeout=30, argument=[{cdn},{auto}]
http-request ^https?:\/\/upos-(?:hz|bstar1)-mirrorakam\.akamaized\.net(?::[0-9]+)?\/upgcxcode\/ script-path=https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/custom/BiliBili.Redirect.CCBStyle.request.js, tag=📺 BiliBili.Redirect.CCBStyle.akamaized, timeout=30, argument=[{cdn},{auto}]
generic script-path=https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/custom/BiliBili.Redirect.CCBStyle.bandwidth.js, tag=🎯 测试当前 CDN 持续带宽, timeout=40, argument=[{cdn},{auto}]
generic script-path=https://raw.githubusercontent.com/vulpsecula/BiliBili-CDN-Loon/main/custom/BiliBili.Redirect.CCBStyle.result.js, tag=📊 查看 CDN 测速状态 / 结果, timeout=10, argument=[{cdn},{auto}]

[MITM]
hostname = api.bilibili.com, api.biliapi.net, *.bilivideo.com, *.bilivideo.cn, *.acgvideo.com, upos-hz-mirrorakam.akamaized.net, upos-bstar1-mirrorakam.akamaized.net